# openssl rand -hex 32 로 만든 긴 무작위 문자열
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# docker compose가 PostgreSQL을 만들 때 사용
POSTGRES_USER=board
POSTGRES_PASSWORD=change-me
POSTGRES_DB=board

# 로컬에서 uv run으로 직접 실행할 때만 사용 (docker compose는 자동 설정)
DATABASE_URL=postgresql+asyncpg://board:change-me@localhost:5432/board
